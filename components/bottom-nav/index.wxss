.nav-space {
  height: calc(112rpx + env(safe-area-inset-bottom));
}

.bottom-nav {
  position: fixed;
  z-index: 50;
  right: 22rpx;
  bottom: 0;
  left: 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  box-sizing: border-box;
  height: calc(96rpx + constant(safe-area-inset-bottom));
  height: calc(96rpx + env(safe-area-inset-bottom));
  padding: 0 14rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 32rpx 32rpx 0 0;
  background: rgba(24, 56, 46, 0.97);
  box-shadow: 0 20rpx 54rpx rgba(20, 42, 33, 0.28);
}

.nav-item {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  color: rgba(255, 253, 247, 0.55);
}

.nav-item.active {
  color: #fffdf7;
}

.nav-item.detect-slot {
  margin-top: -38rpx;
}

.nav-glyph {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 38rpx;
  margin-bottom: 4rpx;
}

.detect-slot .nav-glyph {
  width: 84rpx;
  height: 84rpx;
  border: 8rpx solid #f7f3e9;
  border-radius: 50%;
  background: #d9543d;
  box-shadow: 0 12rpx 24rpx rgba(217, 84, 61, 0.3);
  color: #fff;
}

.nav-label {
  font-size: 19rpx;
  line-height: 24rpx;
}

.detect-slot .nav-label {
  margin-top: 2rpx;
}

.icon-home {
  display: grid;
  grid-template-columns: repeat(2, 8rpx);
  gap: 5rpx;
}

.home-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 3rpx;
  background: currentColor;
}

.icon-chat {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 3rpx;
  width: 36rpx;
  height: 26rpx;
  border: 3rpx solid currentColor;
  border-radius: 8rpx;
}

.icon-chat::after {
  position: absolute;
  bottom: -9rpx;
  left: 8rpx;
  width: 8rpx;
  height: 8rpx;
  border-right: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  background: #18382e;
  content: "";
  transform: rotate(45deg);
}

.chat-dot {
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: currentColor;
}

.icon-book {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 6rpx;
  width: 36rpx;
  height: 32rpx;
  padding-left: 6rpx;
  border-left: 4rpx solid currentColor;
  border-radius: 2rpx;
}

.book-line {
  width: 26rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: currentColor;
}

.book-line.short {
  width: 18rpx;
}

.icon-user {
  position: relative;
  width: 34rpx;
  height: 34rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
}

.user-head {
  position: absolute;
  top: 6rpx;
  left: 10rpx;
  width: 8rpx;
  height: 8rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
}

.user-body {
  position: absolute;
  bottom: 6rpx;
  left: 7rpx;
  width: 14rpx;
  height: 7rpx;
  border: 3rpx solid currentColor;
  border-bottom: 0;
  border-radius: 12rpx 12rpx 0 0;
}

.icon-scan {
  position: relative;
  width: 30rpx;
  height: 30rpx;
}

.scan-corner {
  position: absolute;
  width: 9rpx;
  height: 9rpx;
  border-color: currentColor;
  border-style: solid;
}

.c1 {
  top: 0;
  left: 0;
  border-width: 3rpx 0 0 3rpx;
}

.c2 {
  top: 0;
  right: 0;
  border-width: 3rpx 3rpx 0 0;
}

.c3 {
  bottom: 0;
  left: 0;
  border-width: 0 0 3rpx 3rpx;
}

.c4 {
  right: 0;
  bottom: 0;
  border-width: 0 3rpx 3rpx 0;
}

.scan-dot {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: currentColor;
}
