page {
  --ink: #18382e;
  --ink-soft: #5f6f67;
  --paper: #f7f3e9;
  --paper-deep: #eee7d8;
  --card: #fffdf7;
  --line: rgba(24, 56, 46, 0.1);
  --beef: #d9543d;
  --beef-dark: #aa3b2a;
  --butter: #f2c85b;
  --sage: #a9b89e;
  --mint: #dfe9d8;
  --danger: #bd4a38;
  --shadow: 0 18rpx 50rpx rgba(39, 50, 41, 0.08);
  min-height: 100%;
  background: #f7f3e9;
  color: #18382e;
  font-family: "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.55;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  font-size: inherit;
  line-height: inherit;
}

button::after {
  border: 0;
}

image {
  display: block;
}

view,
text {
  box-sizing: border-box;
}

.page-shell {
  position: relative;
  min-height: 100vh;
  padding: 0 32rpx calc(180rpx + env(safe-area-inset-bottom));
  overflow: hidden;
}

.page-shell.no-nav {
  padding-bottom: calc(54rpx + env(safe-area-inset-bottom));
}

.topbar {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
}

.topbar.narrow {
  height: 76rpx;
}

.brand {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 20rpx 8rpx 20rpx 20rpx;
  background: #18382e;
  color: #fff9ec;
  font-family: "Songti SC", serif;
  font-size: 32rpx;
  font-weight: 700;
  transform: rotate(-3deg);
}

.brand-name {
  font-family: "Songti SC", "STSong", serif;
  font-size: 31rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.brand-sub {
  margin-top: 2rpx;
  color: #7e8d84;
  font-size: 18rpx;
  letter-spacing: 3rpx;
  text-transform: uppercase;
}

.avatar-button,
.avatar-sm {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border: 2rpx solid rgba(24, 56, 46, 0.1);
  border-radius: 50%;
  background: #fffdf7;
  overflow: hidden;
}

.avatar-sm {
  width: 52rpx;
  height: 52rpx;
}

.avatar-image {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  color: #d9543d;
  font-family: "Songti SC", serif;
  font-size: 28rpx;
  font-weight: 700;
}

.back-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  border: 1rpx solid rgba(24, 56, 46, 0.1);
  border-radius: 50%;
  background: rgba(255, 253, 247, 0.82);
  font-size: 34rpx;
  font-weight: 500;
}

.topbar-title {
  font-family: "Songti SC", serif;
  font-size: 32rpx;
  font-weight: 700;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  color: #d9543d;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.eyebrow::before {
  width: 22rpx;
  height: 3rpx;
  border-radius: 4rpx;
  background: #d9543d;
  content: "";
}

.section-title-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 42rpx 0 22rpx;
}

.section-title {
  font-family: "Songti SC", serif;
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.section-hint,
.text-link {
  color: #7d8a82;
  font-size: 23rpx;
}

.text-link {
  display: inline-flex;
  align-items: center;
  gap: 5rpx;
  color: #18382e;
}

.card {
  border: 1rpx solid rgba(24, 56, 46, 0.08);
  border-radius: 30rpx;
  background: #fffdf7;
  box-shadow: 0 18rpx 50rpx rgba(39, 50, 41, 0.06);
}

.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 42rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #edf0e7;
  color: #52685c;
  font-size: 21rpx;
  white-space: nowrap;
}

.pill.red {
  background: #fae7e1;
  color: #b8412e;
}

.pill.yellow {
  background: #f9edc7;
  color: #8a6412;
}

.primary-button,
.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 96rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.primary-button {
  background: #18382e;
  color: #fffdf7;
  box-shadow: 0 16rpx 34rpx rgba(24, 56, 46, 0.2);
}

.primary-button[disabled] {
  opacity: 0.5;
}

.secondary-button {
  border: 1rpx solid rgba(24, 56, 46, 0.13);
  background: rgba(255, 253, 247, 0.86);
  color: #18382e;
}

.button-arrow {
  margin-left: 12rpx;
  font-size: 32rpx;
}

.hairline {
  height: 1rpx;
  background: rgba(24, 56, 46, 0.08);
}

.fade-in {
  animation: fadeUp 420ms ease both;
}

@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes pulseSoft {
  0%,
  100% {
    opacity: 0.58;
    transform: scale(0.98);
  }
  50% {
    opacity: 1;
    transform: scale(1.02);
  }
}
