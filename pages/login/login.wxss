.login-page {
  background:
    radial-gradient(circle at 80% 12%, rgba(242, 200, 91, 0.3), transparent 25%),
    linear-gradient(180deg, #f9f5ea 0%, #f4eddf 100%);
}

.login-orbit {
  position: absolute;
  border: 1rpx solid rgba(24, 56, 46, 0.06);
  border-radius: 50%;
}

.orbit-one {
  top: 120rpx;
  right: -170rpx;
  width: 450rpx;
  height: 450rpx;
}

.orbit-two {
  top: 200rpx;
  right: -90rpx;
  width: 280rpx;
  height: 280rpx;
}

.small-brand .brand-mark {
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx 6rpx 14rpx 14rpx;
  font-size: 24rpx;
}

.small-brand .brand-name {
  font-size: 25rpx;
  letter-spacing: 2rpx;
}

.topbar-spacer {
  width: 68rpx;
}

.login-visual {
  display: flex;
  justify-content: center;
  padding: 44rpx 0 22rpx;
}

.seal {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 260rpx;
  height: 260rpx;
}

.seal-orbit {
  position: absolute;
  width: 246rpx;
  height: 246rpx;
  border: 1rpx dashed rgba(24, 56, 46, 0.18);
  border-radius: 50%;
  animation: slowSpin 24s linear infinite;
}

@keyframes slowSpin {
  to {
    transform: rotate(360deg);
  }
}

.seal-core {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 176rpx;
  height: 176rpx;
  border: 3rpx solid #18382e;
  border-radius: 50%;
  background: #f2c85b;
  box-shadow:
    0 18rpx 36rpx rgba(48, 63, 47, 0.14),
    inset 0 0 0 8rpx rgba(255, 253, 247, 0.28);
}

.seal-face {
  position: relative;
  width: 102rpx;
  height: 92rpx;
  border: 4rpx solid #18382e;
  border-radius: 46% 46% 50% 50%;
  background: rgba(255, 253, 247, 0.22);
}

.cow-horns {
  position: absolute;
  top: 23rpx;
  width: 34rpx;
  height: 36rpx;
  border: 4rpx solid #18382e;
  border-bottom: 0;
  border-radius: 50% 50% 0 0;
}

.h1 {
  left: 35rpx;
  transform: rotate(-22deg);
}

.h2 {
  right: 35rpx;
  transform: rotate(22deg);
}

.seal-eye {
  position: absolute;
  top: 30rpx;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #18382e;
}

.e1 {
  left: 26rpx;
}

.e2 {
  right: 26rpx;
}

.seal-nose {
  position: absolute;
  bottom: 18rpx;
  left: 50%;
  width: 32rpx;
  height: 18rpx;
  border: 3rpx solid #18382e;
  border-radius: 45%;
  transform: translateX(-50%);
}

.seal-star {
  position: absolute;
  color: #d9543d;
  font-size: 26rpx;
}

.star-a {
  top: 15rpx;
  right: 35rpx;
}

.star-b {
  bottom: 30rpx;
  left: 24rpx;
  font-size: 38rpx;
}

.login-copy {
  text-align: center;
}

.login-title {
  margin-top: 11rpx;
  font-family: "Songti SC", serif;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: -1rpx;
}

.login-description {
  width: 570rpx;
  margin: 18rpx auto 0;
  color: #6e7b73;
  font-size: 22rpx;
  line-height: 1.7;
}

.benefit-list {
  margin-top: 28rpx;
  padding: 0 8rpx;
}

.benefit-item {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  border-bottom: 1rpx solid rgba(24, 56, 46, 0.08);
}

.benefit-number {
  width: 52rpx;
  color: #d9543d;
  font-family: "Songti SC", serif;
  font-size: 18rpx;
  font-weight: 700;
}

.benefit-content {
  flex: 1;
}

.benefit-title {
  color: #3d5548;
  font-size: 22rpx;
  font-weight: 600;
}

.benefit-sub {
  margin-top: 2rpx;
  color: #8c968f;
  font-size: 17rpx;
}

.benefit-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 13rpx;
  background: #e6ede0;
  color: #59705e;
  font-family: "Songti SC", serif;
  font-size: 18rpx;
}

.login-primary-zone {
  margin-top: 32rpx;
}

.wechat-button {
  display: flex;
  align-items: center;
  width: 100%;
  height: 106rpx;
  padding: 0 24rpx;
  border-radius: 30rpx;
  background: #18382e;
  color: #fffdf7;
  text-align: left;
  box-shadow: 0 18rpx 38rpx rgba(24, 56, 46, 0.2);
}

.wechat-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin-right: 17rpx;
  border-radius: 50%;
  background: #f2c85b;
  color: #18382e;
  font-family: "Songti SC", serif;
  font-size: 24rpx;
  font-weight: 700;
}

.wechat-title {
  font-size: 26rpx;
  font-weight: 600;
}

.wechat-sub {
  margin-top: 2rpx;
  color: rgba(255, 253, 247, 0.48);
  font-size: 17rpx;
}

.wechat-arrow {
  margin-left: auto;
  color: #f2c85b;
  font-size: 30rpx;
}

.privacy-check {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 18rpx;
}

.check-box {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  margin-right: 9rpx;
  border: 1rpx solid #b4b8b3;
  border-radius: 8rpx;
  color: #fff;
  font-size: 17rpx;
}

.check-box.checked {
  border-color: #d9543d;
  background: #d9543d;
}

.privacy-copy {
  color: #818c85;
  font-size: 18rpx;
}

.privacy-link {
  color: #4c6455;
  text-decoration: underline;
}

.guest-button {
  width: 100%;
  height: 76rpx;
  margin-top: 8rpx;
  color: #66766c;
  font-size: 20rpx;
}

.free-note {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin: 4rpx 0 22rpx;
  color: #9aa29c;
  font-size: 17rpx;
}

.free-dot {
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #85a17b;
}
