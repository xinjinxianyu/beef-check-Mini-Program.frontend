.assistant-page {
  background:
    radial-gradient(circle at 100% 0%, rgba(242, 200, 91, 0.22), transparent 25%),
    linear-gradient(180deg, #f9f5ea 0%, #f7f3e9 100%);
}

.assistant-glow {
  position: absolute;
  top: 110rpx;
  right: -180rpx;
  width: 400rpx;
  height: 400rpx;
  border: 1rpx solid rgba(24, 56, 46, 0.06);
  border-radius: 50%;
}

.ai-status {
  display: flex;
  align-items: center;
  gap: 7rpx;
  height: 52rpx;
  padding: 0 16rpx;
  border: 1rpx solid rgba(24, 56, 46, 0.1);
  border-radius: 999rpx;
  background: rgba(255, 253, 247, 0.72);
  color: #576b60;
  font-size: 18rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.ai-status-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #7f9f74;
  box-shadow: 0 0 0 5rpx rgba(127, 159, 116, 0.1);
}

.assistant-heading {
  padding: 24rpx 0 28rpx;
}

.assistant-heading-top {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.assistant-portrait {
  position: relative;
  display: flex;
  flex: 0 0 112rpx;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
}

.portrait-orbit {
  position: absolute;
  width: 104rpx;
  height: 104rpx;
  border: 1rpx solid rgba(217, 84, 61, 0.22);
  border-radius: 50%;
}

.portrait-orbit::after {
  position: absolute;
  top: -4rpx;
  right: 16rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #f2c85b;
  content: "";
}

.portrait-core {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50% 50% 50% 16rpx;
  background: #d9543d;
  color: #fffdf7;
  font-family: "Songti SC", serif;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 26rpx rgba(217, 84, 61, 0.24);
}

.heading-copy {
  flex: 1;
}

.assistant-title {
  margin-top: 5rpx;
  font-family: "Songti SC", serif;
  font-size: 47rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.assistant-intro {
  margin-top: 15rpx;
  padding-left: 132rpx;
  color: #748178;
  font-size: 21rpx;
  line-height: 1.65;
}

.context-card {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: #e3eadc;
}

.context-left {
  flex: 1;
}

.context-label {
  color: #718075;
  font-size: 17rpx;
  letter-spacing: 1rpx;
}

.context-value {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 2rpx;
  font-family: "Songti SC", serif;
  font-size: 30rpx;
  font-weight: 700;
}

.context-ready {
  padding: 3rpx 10rpx;
  border-radius: 99rpx;
  background: rgba(24, 56, 46, 0.08);
  color: #5a6f60;
  font-family: "PingFang SC", sans-serif;
  font-size: 16rpx;
  font-weight: 400;
}

.context-switch {
  height: 56rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(24, 56, 46, 0.1);
  border-radius: 16rpx;
  background: rgba(255, 253, 247, 0.58);
  color: #40584b;
  font-size: 19rpx;
  line-height: 56rpx;
}

.chat-shell {
  margin-top: 18rpx;
  overflow: hidden;
  border: 1rpx solid rgba(24, 56, 46, 0.07);
  border-radius: 30rpx;
  background: #fffdf7;
}

.chat-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 78rpx;
  padding: 0 24rpx;
  border-bottom: 1rpx solid rgba(24, 56, 46, 0.07);
}

.chat-head-left {
  display: flex;
  align-items: center;
  gap: 9rpx;
  color: #52665b;
  font-size: 19rpx;
}

.chat-online {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #7f9f74;
}

.chat-private {
  color: #9aa29c;
  font-size: 17rpx;
}

.message-scroll {
  height: 610rpx;
}

.message-list {
  padding: 24rpx 22rpx 42rpx;
}

.message-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 26rpx;
}

.message-row.user {
  justify-content: flex-end;
}

.message-avatar,
.user-avatar {
  display: flex;
  flex: 0 0 54rpx;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border-radius: 18rpx 18rpx 18rpx 5rpx;
  background: #d9543d;
  color: #fffdf7;
  font-family: "Songti SC", serif;
  font-size: 21rpx;
  font-weight: 700;
}

.user-avatar {
  margin-left: 12rpx;
  border-radius: 18rpx 18rpx 5rpx 18rpx;
  background: #18382e;
}

.message-main {
  max-width: 78%;
  margin-left: 12rpx;
}

.user .message-main {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-right: 12rpx;
  margin-left: 0;
}

.message-bubble {
  padding: 18rpx 20rpx;
  border-radius: 6rpx 22rpx 22rpx 22rpx;
  background: #f3f0e7;
  color: #344c40;
  font-size: 22rpx;
  line-height: 1.7;
}

.notice-bubble {
  border: 1rpx solid rgba(217, 84, 61, 0.16);
  background: #fdf0eb;
  color: #8d493d;
}

.user .message-bubble {
  border-radius: 22rpx 6rpx 22rpx 22rpx;
  background: #18382e;
  color: #fffdf7;
}

.message-meta {
  margin-top: 7rpx;
  color: #9aa29b;
  font-size: 16rpx;
}

.user .message-meta {
  text-align: right;
}

.answer-tag {
  margin-left: 9rpx;
  padding: 2rpx 8rpx;
  border-radius: 99rpx;
  background: #e4eddd;
  color: #667c66;
}

.blocked-tag {
  background: #fae6e0;
  color: #b44230;
}

.message-disclaimer {
  margin-top: 10rpx;
  padding: 10rpx 12rpx;
  border-left: 3rpx solid #d6caca;
  color: #929a94;
  font-size: 16rpx;
  line-height: 1.55;
}

.typing-bubble {
  display: flex;
  align-items: center;
  gap: 7rpx;
  min-width: 96rpx;
  min-height: 62rpx;
}

.typing-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #8a978f;
  animation: typing 1.1s ease-in-out infinite;
}

.typing-dot.d2 {
  animation-delay: 120ms;
}

.typing-dot.d3 {
  animation-delay: 240ms;
}

@keyframes typing {
  0%,
  100% {
    opacity: 0.3;
    transform: translateY(0);
  }
  50% {
    opacity: 1;
    transform: translateY(-4rpx);
  }
}

.scroll-anchor {
  height: 2rpx;
}

.question-panel {
  margin-top: 18rpx;
}

.question-panel-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.question-title {
  font-family: "Songti SC", serif;
  font-size: 34rpx;
  font-weight: 700;
}

.question-sub {
  margin-top: 2rpx;
  color: #89948c;
  font-size: 18rpx;
}

.question-count {
  color: #909991;
  font-size: 18rpx;
}

.question-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.assistant-question {
  position: relative;
  min-height: 124rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(24, 56, 46, 0.09);
  border-radius: 22rpx;
  background: #fffdf7;
}

.question-category {
  color: #d9543d;
  font-size: 16rpx;
  letter-spacing: 1rpx;
}

.question-label {
  margin-top: 7rpx;
  padding-right: 28rpx;
  color: #2d493b;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.4;
}

.question-arrow {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  color: #849087;
  font-size: 23rpx;
}

.ask-composer {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 18rpx;
  padding: 14rpx 14rpx 14rpx 20rpx;
  border: 2rpx solid rgba(217, 84, 61, 0.24);
  border-radius: 28rpx;
  background: linear-gradient(135deg, #fffdf7 0%, #fcf0e9 100%);
  box-shadow: 0 16rpx 36rpx rgba(70, 54, 42, 0.1);
}

.ask-input-wrap {
  flex: 1;
  min-width: 0;
  padding: 2rpx 0;
}

.ask-prompt-label {
  display: flex;
  align-items: center;
  gap: 7rpx;
  margin-bottom: 2rpx;
  color: #b34130;
  font-size: 16rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.ask-prompt-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #d9543d;
  box-shadow: 0 0 0 5rpx rgba(217, 84, 61, 0.09);
}

.ask-input {
  width: 100%;
  height: 64rpx;
  padding: 0;
  color: #263f33;
  font-size: 23rpx;
  font-weight: 500;
}

.ask-placeholder {
  color: #a0a8a2;
}

.ask-send {
  display: flex;
  flex: 0 0 72rpx;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: #ebe7df;
  color: #a4aba6;
  font-size: 34rpx;
  font-weight: 700;
}

.ask-send.ready {
  background: #d9543d;
  color: #fffdf7;
  box-shadow: 0 9rpx 20rpx rgba(217, 84, 61, 0.22);
}

.ask-send[disabled] {
  opacity: 1;
}

.policy-row {
  display: flex;
  align-items: flex-start;
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 20rpx;
  background: rgba(239, 234, 223, 0.66);
  color: #78857d;
  font-size: 18rpx;
}

.policy-icon {
  display: flex;
  flex: 0 0 30rpx;
  align-items: center;
  justify-content: center;
  width: 30rpx;
  height: 30rpx;
  margin-right: 10rpx;
  border: 1rpx solid #9da69f;
  border-radius: 50%;
  font-family: "Songti SC", serif;
  font-size: 16rpx;
}

.policy-copy {
  flex: 1;
}

.policy-detail {
  margin-top: 8rpx;
  line-height: 1.65;
}

.policy-more {
  margin-left: 12rpx;
  font-size: 24rpx;
}

