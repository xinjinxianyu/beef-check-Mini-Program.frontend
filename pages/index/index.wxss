.home-page {
  background:
    radial-gradient(circle at 90% 8%, rgba(242, 200, 91, 0.24), transparent 24%),
    linear-gradient(180deg, #f9f5ea 0%, #f7f3e9 52%, #f5efe2 100%);
}

.grain {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  filter: blur(2rpx);
}

.grain-one {
  top: 280rpx;
  right: -160rpx;
  width: 420rpx;
  height: 420rpx;
  border: 1rpx solid rgba(24, 56, 46, 0.06);
}

.grain-two {
  top: 330rpx;
  right: -110rpx;
  width: 280rpx;
  height: 280rpx;
  border: 1rpx solid rgba(24, 56, 46, 0.05);
}

.hero-copy {
  position: relative;
  z-index: 2;
  padding: 30rpx 4rpx 28rpx;
}

.hero-title {
  display: flex;
  flex-direction: column;
  margin-top: 16rpx;
  font-family: "Songti SC", "STSong", serif;
  font-size: 74rpx;
  font-weight: 700;
  line-height: 1.08;
  letter-spacing: -2rpx;
}

.hero-accent {
  color: #d9543d;
}

.hero-description {
  width: 570rpx;
  margin-top: 22rpx;
  color: #68766e;
  font-size: 26rpx;
  line-height: 1.7;
}

.scan-panel {
  position: relative;
  padding: 24rpx;
  overflow: hidden;
  border-radius: 38rpx;
  background: #18382e;
  box-shadow: 0 28rpx 60rpx rgba(24, 56, 46, 0.22);
}

.scan-panel::before {
  position: absolute;
  top: -180rpx;
  right: -80rpx;
  width: 420rpx;
  height: 420rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  border-radius: 50%;
  content: "";
}

.scan-corner {
  position: absolute;
  z-index: 4;
  width: 34rpx;
  height: 34rpx;
  border-color: rgba(255, 253, 247, 0.45);
  border-style: solid;
}

.corner-tl {
  top: 18rpx;
  left: 18rpx;
  border-width: 2rpx 0 0 2rpx;
}

.corner-tr {
  top: 18rpx;
  right: 18rpx;
  border-width: 2rpx 2rpx 0 0;
}

.corner-bl {
  bottom: 18rpx;
  left: 18rpx;
  border-width: 0 0 2rpx 2rpx;
}

.corner-br {
  right: 18rpx;
  bottom: 18rpx;
  border-width: 0 2rpx 2rpx 0;
}

.scan-panel-head {
  position: relative;
  z-index: 4;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.live-pill {
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 44rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.13);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.06);
  color: #fffdf7;
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.live-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #f2c85b;
  box-shadow: 0 0 0 6rpx rgba(242, 200, 91, 0.1);
}

.scan-panel-note {
  color: rgba(255, 253, 247, 0.48);
  font-size: 19rpx;
}

.beef-illustration {
  position: relative;
  height: 370rpx;
}

.plate-shadow {
  position: absolute;
  bottom: 28rpx;
  left: 50%;
  width: 430rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.2);
  filter: blur(16rpx);
  transform: translateX(-50%);
}

.plate {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 430rpx;
  height: 268rpx;
  border: 3rpx solid rgba(255, 253, 247, 0.26);
  border-radius: 50%;
  background: radial-gradient(ellipse at center, #f8f3e8 0%, #e9e1d1 74%, #d4cbb9 100%);
  box-shadow:
    inset 0 -14rpx 25rpx rgba(70, 59, 43, 0.08),
    0 18rpx 34rpx rgba(0, 0, 0, 0.18);
  transform: translate(-50%, -50%) rotate(-3deg);
}

.steak {
  position: absolute;
  top: 42rpx;
  left: 100rpx;
  width: 250rpx;
  height: 178rpx;
  border: 7rpx solid #9e3326;
  border-radius: 50% 43% 48% 42% / 50% 55% 44% 47%;
  background:
    radial-gradient(ellipse at 70% 22%, rgba(255, 183, 137, 0.65) 0 3%, transparent 4%),
    radial-gradient(circle at 20% 76%, #bd4a37 0 9%, transparent 10%),
    radial-gradient(circle at 72% 66%, #ba4836 0 11%, transparent 12%),
    linear-gradient(135deg, #dd7259, #bd4433 60%, #8f2d28);
  box-shadow: inset 0 8rpx 20rpx rgba(255, 190, 151, 0.2);
  transform: rotate(-8deg);
}

.steak-highlight {
  position: absolute;
  top: 22rpx;
  right: 28rpx;
  width: 90rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(255, 207, 172, 0.16);
  filter: blur(6rpx);
  transform: rotate(-15deg);
}

.marbling {
  position: absolute;
  height: 4rpx;
  border-radius: 50%;
  background: rgba(255, 237, 210, 0.75);
  transform: rotate(-12deg);
}

.marble-a {
  top: 54rpx;
  left: 50rpx;
  width: 78rpx;
}

.marble-b {
  top: 78rpx;
  left: 108rpx;
  width: 104rpx;
  transform: rotate(18deg);
}

.marble-c {
  top: 108rpx;
  left: 62rpx;
  width: 86rpx;
  transform: rotate(8deg);
}

.marble-d {
  top: 130rpx;
  left: 122rpx;
  width: 60rpx;
  transform: rotate(-22deg);
}

.herb {
  position: absolute;
  width: 46rpx;
  height: 16rpx;
  border-radius: 80% 10% 80% 10%;
  background: #496b43;
}

.herb-a {
  top: 58rpx;
  left: 90rpx;
  transform: rotate(35deg);
}

.herb-b {
  bottom: 52rpx;
  right: 86rpx;
  transform: rotate(-30deg);
}

.scan-beam {
  position: absolute;
  top: 76rpx;
  left: 34rpx;
  width: 580rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #f2c85b 32%, #fff7d3 50%, #f2c85b 68%, transparent);
  box-shadow: 0 0 15rpx rgba(242, 200, 91, 0.65);
  animation: scanLine 3s ease-in-out infinite;
}

@keyframes scanLine {
  0%,
  100% {
    opacity: 0.35;
    transform: translateY(0);
  }
  50% {
    opacity: 1;
    transform: translateY(190rpx);
  }
}

.floating-label {
  position: absolute;
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 46rpx;
  padding: 0 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 999rpx;
  background: rgba(12, 32, 25, 0.86);
  color: #fffdf7;
  font-size: 19rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  box-shadow: 0 8rpx 20rpx rgba(7, 22, 16, 0.16);
  backdrop-filter: blur(8rpx);
}

.label-cut {
  top: 82rpx;
  left: 44rpx;
  border-color: rgba(255, 255, 255, 0.55);
  background: rgba(255, 253, 247, 0.92);
  color: #18382e;
}

.label-fresh {
  right: 38rpx;
  bottom: 78rpx;
  border-color: rgba(242, 200, 91, 0.2);
  background: rgba(15, 42, 34, 0.82);
}

.label-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #d9543d;
  box-shadow: 0 0 0 5rpx rgba(217, 84, 61, 0.1);
}

.fresh-status-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #9fbd8c;
  box-shadow: 0 0 0 5rpx rgba(159, 189, 140, 0.1);
}

.scan-action {
  position: relative;
  z-index: 4;
  display: flex;
  align-items: center;
  width: 100%;
  height: 108rpx;
  padding: 0 24rpx;
  border-radius: 26rpx;
  background: #fffdf7;
  color: #18382e;
  text-align: left;
}

.scan-icon-mini {
  position: relative;
  width: 50rpx;
  height: 50rpx;
  margin-right: 18rpx;
  border-radius: 16rpx;
  background: #fae7e1;
}

.mini-corner {
  position: absolute;
  width: 11rpx;
  height: 11rpx;
  border-color: #d9543d;
  border-style: solid;
}

.m1 {
  top: 12rpx;
  left: 12rpx;
  border-width: 2rpx 0 0 2rpx;
}

.m2 {
  top: 12rpx;
  right: 12rpx;
  border-width: 2rpx 2rpx 0 0;
}

.m3 {
  bottom: 12rpx;
  left: 12rpx;
  border-width: 0 0 2rpx 2rpx;
}

.m4 {
  right: 12rpx;
  bottom: 12rpx;
  border-width: 0 2rpx 2rpx 0;
}

.scan-action-title {
  font-size: 28rpx;
  font-weight: 600;
}

.round-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  margin-left: auto;
  border-radius: 50%;
  background: #18382e;
  color: #fffdf7;
  font-size: 28rpx;
}

.mini-stats {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  padding: 24rpx 8rpx;
}

.mini-stat {
  display: flex;
  flex: 1;
  align-items: center;
  gap: 14rpx;
}

.stat-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border: 1rpx solid rgba(24, 56, 46, 0.09);
  border-radius: 50%;
  color: #d9543d;
  font-size: 26rpx;
}

.stat-value {
  font-size: 23rpx;
  font-weight: 600;
}

.stat-label {
  margin-top: 1rpx;
  color: #869188;
  font-size: 18rpx;
}

.stat-divider {
  width: 1rpx;
  height: 48rpx;
  margin: 0 16rpx;
  background: rgba(24, 56, 46, 0.1);
}

.utility-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.utility-card {
  position: relative;
  min-height: 226rpx;
  padding: 28rpx;
  overflow: hidden;
  border-radius: 30rpx;
}

.utility-card.red {
  background: #d9543d;
  color: #fff8ec;
}

.utility-card.sage {
  border: 1rpx solid rgba(24, 56, 46, 0.08);
  background: #e3eadc;
  color: #18382e;
}

.utility-content {
  position: relative;
  z-index: 3;
  width: 64%;
}

.utility-eyebrow {
  font-size: 18rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  opacity: 0.7;
}

.utility-title {
  margin-top: 8rpx;
  font-family: "Songti SC", serif;
  font-size: 36rpx;
  font-weight: 700;
}

.utility-description {
  margin-top: 8rpx;
  font-size: 21rpx;
  line-height: 1.55;
  opacity: 0.68;
}

.utility-link {
  position: absolute;
  bottom: 24rpx;
  left: 28rpx;
  z-index: 3;
  font-size: 21rpx;
  font-weight: 600;
}

.utility-link text {
  margin-left: 8rpx;
}

.utility-art {
  position: absolute;
  top: 0;
  right: 0;
  width: 250rpx;
  height: 100%;
}

.assistant-art {
  position: absolute;
  top: 42rpx;
  right: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 150rpx;
  height: 150rpx;
}

.assistant-ring {
  position: absolute;
  border: 1rpx solid rgba(255, 253, 247, 0.25);
  border-radius: 50%;
}

.ring-one {
  width: 150rpx;
  height: 150rpx;
}

.ring-two {
  width: 112rpx;
  height: 112rpx;
}

.assistant-core {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50% 50% 50% 14rpx;
  background: #f2c85b;
  color: #18382e;
  font-family: "Songti SC", serif;
  font-size: 32rpx;
  font-weight: 700;
}

.book-art {
  position: absolute;
  top: 60rpx;
  right: 36rpx;
  width: 138rpx;
  height: 106rpx;
  transform: rotate(-7deg);
}

.book-page {
  position: absolute;
  top: 0;
  width: 69rpx;
  height: 102rpx;
  border: 2rpx solid rgba(24, 56, 46, 0.2);
  background:
    repeating-linear-gradient(180deg, transparent 0 15rpx, rgba(24, 56, 46, 0.08) 16rpx 18rpx),
    #fffdf7;
}

.page-left {
  left: 0;
  border-radius: 8rpx 2rpx 2rpx 20rpx;
  transform: skewY(4deg);
}

.page-right {
  right: 0;
  border-radius: 2rpx 8rpx 20rpx 2rpx;
  transform: skewY(-4deg);
}

.book-spine {
  position: absolute;
  top: 4rpx;
  left: 68rpx;
  width: 2rpx;
  height: 100rpx;
  background: rgba(24, 56, 46, 0.2);
}

.article-scroll {
  width: calc(100% + 32rpx);
  margin-right: -32rpx;
}

.article-row {
  display: flex;
  gap: 18rpx;
  width: max-content;
  padding-right: 32rpx;
}

.article-card {
  position: relative;
  width: 420rpx;
  min-height: 324rpx;
  padding: 26rpx;
  overflow: hidden;
  border: 1rpx solid rgba(24, 56, 46, 0.08);
  border-radius: 30rpx;
  background: #fffdf7;
}

.article-card.red {
  border-top: 8rpx solid #d9543d;
}

.article-card.dark {
  border-top: 8rpx solid #18382e;
}

.article-card.yellow {
  border-top: 8rpx solid #f2c85b;
}

.article-orbit {
  position: absolute;
  top: -100rpx;
  right: -90rpx;
  width: 260rpx;
  height: 260rpx;
  border: 1rpx solid rgba(24, 56, 46, 0.07);
  border-radius: 50%;
}

.article-index {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  color: rgba(24, 56, 46, 0.16);
  font-family: "Songti SC", serif;
  font-size: 42rpx;
  font-weight: 700;
}

.article-kicker {
  color: #d9543d;
  font-size: 18rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.article-title {
  margin-top: 10rpx;
  font-family: "Songti SC", serif;
  font-size: 44rpx;
  font-weight: 700;
}

.article-subtitle {
  color: #8a948d;
  font-size: 18rpx;
  letter-spacing: 1rpx;
}

.article-rule {
  width: 40rpx;
  height: 2rpx;
  margin: 20rpx 0 14rpx;
  background: #18382e;
}

.article-summary {
  width: 330rpx;
  color: #65736b;
  font-size: 21rpx;
  line-height: 1.65;
}

.article-more {
  margin-top: 16rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.home-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 58rpx;
}

.footer-line {
  width: 34rpx;
  height: 2rpx;
  margin-bottom: 16rpx;
  background: #b7beb5;
}

.footer-copy {
  color: #9aa39c;
  font-family: "Songti SC", serif;
  font-size: 20rpx;
  letter-spacing: 2rpx;
}


.camera-preview {
  overflow: hidden;
  border-radius: 26rpx;
  background: #c9bba7;
}

.camera-image {
  display: block;
  width: 100%;
  height: 100%;
  filter: none;
}

.camera-vignette {
  position: absolute;
  z-index: 2;
  inset: 0;
  background:
    radial-gradient(circle at 8% 22%, rgba(255, 246, 218, 0.25) 0%, transparent 34%),
    radial-gradient(circle at 90% 68%, rgba(255, 245, 218, 0.2) 0%, transparent 32%),
    linear-gradient(180deg, rgba(255, 249, 233, 0.04) 0%, rgba(10, 28, 22, 0) 46%, rgba(10, 28, 22, 0.12) 100%);
  pointer-events: none;
}

.plate-shadow,
.plate,
.steak,
.herb {
  display: none;
}

.scan-beam {
  z-index: 3;
}

.floating-label {
  z-index: 4;
}


.live-pill {
  width: 44rpx;
  padding: 0;
  justify-content: center;
  gap: 0;
}
